[options]
mode prove
depth 4
multiclock off

[engines]
smtbmc yices

[script]
read_verilog -sv -formal -I. nqx_s1_cordic.sv nqx_s1_cordic_iter.sv nqx_s1_rcode.sv nqx_s1_rsign.sv nqx_s1_tcode.sv nqx_s1_qdec.sv nqx_s1_div28.sv nqx_s1_rf.sv nqx_s1_core.sv
